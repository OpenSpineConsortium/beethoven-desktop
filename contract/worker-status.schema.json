{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/OpenSpineConsortium/hpcworker/interface/contract/worker-status.schema.json",
 "title": "worker status --json",
 "description": "The one line `hpcworker worker status --name NAME --json` prints (and the gate's `status NAME`), and each event line of the gate's `watch NAME`. docs/V11_CONTRACT.md section 6, docs/V12_CONTRACT.md 'The gate'.",
 "anyOf": [
  {"$ref": "#/$defs/status_line"},
  {"$ref": "#/$defs/watch_status"},
  {"$ref": "#/$defs/watch_keepalive"}
 ],
 "$defs": {
  "fields": {
   "type": "object",
   "required": ["v", "run", "job", "next_job", "state_dir", "status", "connection", "scheduler", "line"],
   "properties": {
    "v": {"const": 1},
    "run": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
    "job": {"type": "string", "pattern": "^[0-9]*$"},
    "next_job": {"type": "string", "pattern": "^[0-9]*$"},
    "state_dir": {"type": "string"},
    "status": {"anyOf": [{"type": "null"}, {"$ref": "status.schema.json"}]},
    "connection": {"anyOf": [{"type": "null"}, {"$ref": "connection.schema.json"}]},
    "scheduler": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/scheduler"}]},
    "line": {"type": "string", "description": "one sentence for a person; the extension words its own"}
   },
   "additionalProperties": true
  },
  "status_line": {
   "allOf": [{"$ref": "#/$defs/fields"}, {"not": {"required": ["event"]}}]
  },
  "watch_status": {
   "allOf": [
    {"$ref": "#/$defs/fields"},
    {"type": "object", "required": ["event", "final"], "properties": {"event": {"const": "status"}, "final": {"type": "boolean"}}}
   ]
  },
  "watch_keepalive": {
   "type": "object",
   "required": ["v", "event", "at"],
   "properties": {
    "v": {"const": 1},
    "event": {"const": "keepalive"},
    "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
   },
   "additionalProperties": false
  },
  "scheduler": {
   "type": "object",
   "description": "the one squeue answer, only while status.json says queued",
   "required": ["state", "reason", "expected_start", "node", "checked_at"],
   "properties": {
    "state": {"type": "string", "description": "Slurm's %T, or GONE when the scheduler no longer lists the job"},
    "reason": {"type": "string"},
    "expected_start": {"type": "string", "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)$"},
    "node": {"type": "string"},
    "checked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
   },
   "additionalProperties": true
  }
 }
}
