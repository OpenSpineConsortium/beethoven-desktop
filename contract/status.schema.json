{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/OpenSpineConsortium/hpcworker/interface/contract/status.schema.json",
 "title": "status.json",
 "description": "<state_dir>/<name>/status.json, written atomically by `worker start` (the queued file), `worker status` (the scheduler fields while queued), `worker stop` (a worker still in line) and the job (every other write). docs/V11_CONTRACT.md section 9. A reader ignores a field it does not know: a new optional field keeps the export's version.",
 "type": "object",
 "required": ["version", "site", "run", "job", "node", "state", "message", "needs", "hint", "submitted_at", "updated_at", "title", "requested_name", "renewal", "chain", "next_job", "consent", "consent_source"],
 "properties": {
  "version": {"type": "integer", "minimum": 9, "description": "the framework version that wrote the file"},
  "site": {"type": "string"},
  "run": {"$ref": "#/$defs/name"},
  "job": {"$ref": "#/$defs/job"},
  "node": {"type": "string", "description": "the compute node; empty while queued"},
  "pid": {"type": "integer"},
  "state": {"enum": ["queued", "starting", "need_login", "need_consent", "running", "online", "stopped", "preempted", "error"]},
  "message": {"type": "string", "description": "the tool's words, for Details only"},
  "needs": {"enum": ["login", "consent", "nothing"]},
  "hint": {"type": "string"},
  "submitted_at": {"$ref": "#/$defs/time_or_empty"},
  "got_computer_at": {"$ref": "#/$defs/time_or_empty"},
  "started_at": {"$ref": "#/$defs/time_or_empty"},
  "online_at": {"$ref": "#/$defs/time_or_empty"},
  "ends_at": {"$ref": "#/$defs/time_or_empty"},
  "renewal": {"type": "boolean"},
  "updated_at": {"$ref": "#/$defs/time"},
  "title": {"type": "string"},
  "session_name": {"type": "string"},
  "requested_name": {"type": "string"},
  "session_url": {"$ref": "#/$defs/claude_link_or_empty"},
  "environment_url": {"$ref": "#/$defs/claude_link_or_empty"},
  "environment_id": {"type": "string", "pattern": "^(|env_[A-Za-z0-9_-]+)$"},
  "claude_login": {
   "type": "object",
   "description": "what `claude auth status` said, re-checked every 300 s; never a token",
   "required": ["loggedIn"],
   "properties": {
    "loggedIn": {"type": "boolean"},
    "email": {"type": "string"},
    "subscriptionType": {"type": "string"},
    "checked_at": {"$ref": "#/$defs/time_or_empty"}
   }
  },
  "consent": {"type": "boolean"},
  "consent_source": {"enum": ["claude_config", "marker", "none"]},
  "workspace_trusted": {"type": "boolean"},
  "rc_alive": {"type": "boolean"},
  "resumed": {"type": "boolean"},
  "tmux": {"type": "boolean"},
  "restarts": {"type": "integer", "minimum": 0},
  "chain": {"type": "boolean"},
  "next_job": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/job"}]},
  "chain_note": {"type": "string"},
  "scheduler_in_worker": {"type": "boolean"},
  "scheduler_note": {"type": "string"},
  "workspace": {"type": "string"},
  "rc_log": {"type": "string"},
  "token_path": {"type": "string"},
  "stop_reason": {"enum": ["request", "login_abandoned", "successor_gone"], "description": "state stopped only"},
  "scheduler_state": {"type": "string", "description": "while queued: Slurm's %T, or GONE; empty otherwise"},
  "reason": {"type": "string", "description": "while queued: Slurm's %r"},
  "expected_start": {"$ref": "#/$defs/time_or_empty"},
  "checked_at": {"$ref": "#/$defs/time_or_empty"}
 },
 "additionalProperties": true,
 "$defs": {
  "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
  "job": {"type": "string", "pattern": "^[0-9]+$"},
  "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
  "time_or_empty": {"type": "string", "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)$"},
  "claude_link_or_empty": {"type": "string", "pattern": "^(|https://claude\\.(ai|com)/code(\\?environment=env_|/session_)[A-Za-z0-9_-]+)$"}
 }
}
